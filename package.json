{
  "name": "icepay-for-woocommerce",
  "version": "1.1.2",
  "description": "```bash cp .env.example .env docker compose up -d make install ```",
  "scripts": {
    "build": "wp-scripts build",
    "check-engines": "wp-scripts check-engines",
    "check-licenses": "wp-scripts check-licenses",
    "format": "wp-scripts format",
    "lint:css": "wp-scripts lint-style",
    "lint:js": "wp-scripts lint-js blocks webpack.config.js eslint.config.cjs tests/Browser/*.cjs --max-warnings=0",
    "lint:md:docs": "wp-scripts lint-md-docs",
    "lint:pkg-json": "wp-scripts lint-pkg-json",
    "packages-update": "wp-scripts packages-update",
    "plugin-zip": "wp-scripts plugin-zip",
    "start": "wp-scripts start",
    "test:e2e": "wp-scripts test-e2e",
    "test:unit": "wp-scripts test-unit-js",
    "test:attribution": "node tests/Browser/order-attribution.cjs",
    "test:restrictions": "node tests/Browser/payment-restrictions.cjs",
    "build-plugin": "composer install --no-dev --prefer-dist --no-interaction && pnpm install --frozen-lockfile && pnpm run build && pnpm run archive",
    "archive": "zip -qr $npm_package_name.zip . -x@exclude.lst",
    "check:archive": "php scripts/check-archive.php icepay-for-woocommerce.zip"
  },
  "author": "",
  "license": "GPLV3",
  "devDependencies": {
    "@woocommerce/dependency-extraction-webpack-plugin": "^5.1.0",
    "@wordpress/scripts": "^32.6.0"
  },
  "packageManager": "pnpm@11.15.1",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.23.3",
      "onFail": "download"
    }
  }
}
