{
  "name": "icepay/icepay-woocommerce",
  "description": "ICEPAY for WooCommerce",
  "type": "library",
  "keywords": [
    "icepay",
    "payment",
    "service",
    "WooCommerce",
    "bancontact",
    "refund",
    "api",
    "payments",
    "gateway"
  ],
  "homepage": "https://www.icepay.com",
  "license": "GPL-3.0-or-later",
  "authors": [
    {
      "name": "ICEPAY B.V.",
      "email": "info@icepay.com"
    }
  ],
  "support": {
    "email": "info@icepay.com"
  },
  "require": {
    "php": ">=8.2",
    "ext-intl": "*",
    "ext-json": "*",
    "psr/log": "^1.1.4",
    "ext-mbstring": "*"
  },
  "require-dev": {
    "squizlabs/php_codesniffer": "3.*",
    "wp-coding-standards/wpcs": "^3.0",
    "phpstan/phpstan": "^2.0",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "phpstan/extension-installer": "^1.3",
    "php-stubs/woocommerce-stubs": "^8.7"
  },
  "autoload": {
    "psr-4": {
      "Icepay\\WooCommerce\\": "src/"
    }
  },
  "scripts": {
    "phpcs": "@php vendor/bin/phpcs -s --standard=phpcs.xml",
    "phpcbf": "@php vendor/bin/phpcbf --standard=phpcs.xml",
    "phpstan": "@php vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit 1G",
    "test": "docker compose exec -T app wp eval-file wp-content/plugins/icepay-for-woocommerce/tests/run.php",
    "check": ["@phpcs", "@phpstan"]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
