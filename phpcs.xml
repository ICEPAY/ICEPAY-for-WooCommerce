<?xml version="1.0"?>
<ruleset name="ICEPAY">
    <description>PHP correctness checks. Existing tab-based formatting is preserved.</description>
    <file>src</file>
    <file>ICEPAY-for-WooCommerce.php</file>
    <file>tests</file>
    <arg name="extensions" value="php"/>
    <rule ref="Generic.PHP.Syntax"/>
    <rule ref="Generic.PHP.DisallowShortOpenTag"/>
    <rule ref="Generic.PHP.LowerCaseConstant"/>
    <rule ref="Generic.Files.EndFileNewline"/>
</ruleset>
