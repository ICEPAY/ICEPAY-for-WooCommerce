#: src/Admin/Tabs/GeneralTab.php:70
msgid "Expire after"
msgstr "Vervalt na"

#: src/Admin/Tabs/GeneralTab.php:72
msgid "In minutes. By default the payment expires after four hours (240 minutes)."
msgstr "Aantal minuten voordat de betaling vervalt. Standaard is dit vier uur (240 minuten)."

#: src/PaymentMethod.php:103
msgid "Allowed billing countries"
msgstr "Toegestane landen voor het factuuradres"

#: src/PaymentMethod.php:106
msgid "Leave empty to allow all billing countries."
msgstr "Laat dit veld leeg om alle landen voor het factuuradres toe te staan."

#: src/PaymentMethod.php:109
msgid "Minimum order amount"
msgstr "Minimaal bestelbedrag"

#: src/PaymentMethod.php:110
msgid "Inclusive, in the order currency, including tax and shipping. Leave empty for no minimum."
msgstr "Een bestelbedrag dat gelijk is aan het minimum is toegestaan. Het bedrag is in de valuta van de bestelling, inclusief btw en verzendkosten. Laat dit veld leeg om geen minimum in te stellen."

#: src/PaymentMethod.php:113
msgid "Maximum order amount"
msgstr "Maximaal bestelbedrag"

#: src/PaymentMethod.php:114
msgid "Inclusive, in the order currency, including tax and shipping. Leave empty for no maximum."
msgstr "Een bestelbedrag dat gelijk is aan het maximum is toegestaan. Het bedrag is in de valuta van de bestelling, inclusief btw en verzendkosten. Laat dit veld leeg om geen maximum in te stellen."

#: src/PaymentMethod.php:119
msgid "Separate icons in legacy checkout"
msgstr "Afzonderlijke pictogrammen op de klassieke afrekenpagina"

#: src/Gateway.php:67
#: src/Gateway.php:70
msgid "Select valid billing countries."
msgstr "Selecteer geldige landen voor het factuuradres."

#: src/Gateway.php:80
#: src/Gateway.php:90
msgid "The minimum order amount cannot exceed the maximum."
msgstr "Het minimumbedrag mag niet hoger zijn dan het maximumbedrag."

#: src/Gateway.php:101
msgid "Order amount limits must be non-negative numbers with at most two decimal places, or empty."
msgstr "Minimum- en maximumbedragen moeten 0 of hoger zijn en mogen maximaal twee decimalen bevatten. Je kunt de velden ook leeg laten."

#: src/Gateway.php:105
msgid "Order amount limits must be non-negative numbers or empty."
msgstr "Minimum- en maximumbedragen moeten 0 of hoger zijn. Je kunt de velden ook leeg laten."

msgid "Merchant ID"
msgstr "Merchant ID"

msgid "Secret"
msgstr "Secret"

msgid "Reference"
msgstr "Referentie"

msgid "Enable Logs"
msgstr "Logboek inschakelen"

msgid "Show Icons"
msgstr "Iconen tonen"

msgid "Support"
msgstr "Support"

msgid "Get the Merchant ID from your ICEPAY account."
msgstr "Haal de Merchant ID op uit je ICEPAY-account."

msgid "Get the Secret from your ICEPAY account."
msgstr "Haal het Secret op uit je ICEPAY-account."

msgid "Setting for your ICEPAY account."
msgstr "Instellingen voor je ICEPAY-account."

msgid "Reference shown on payment. {ORDER_ID} will be replaced with the order id."
msgstr "Referentie die bij de betaling wordt getoond. {ORDER_ID} wordt vervangen door het bestelnummer."

msgid "Order #{ORDER_ID}"
msgstr "Bestelling #{ORDER_ID}"

msgid "For support please send an email to info@icepay.com"
msgstr "Stuur voor support een e-mail naar info@icepay.com"

msgid "We could not start your payment. Please try again or choose another payment method."
msgstr "We konden je betaling niet starten. Probeer het opnieuw of kies een andere betaalmethode."

msgid "We could not open your payment page. Please check your order before trying again."
msgstr "We konden je betaalpagina niet openen. Controleer je bestelling voordat je het opnieuw probeert."

msgid "We could not confirm your payment. Please check your order before trying again."
msgstr "We konden je betaling niet bevestigen. Controleer je bestelling voordat je het opnieuw probeert."

msgid "We could not confirm whether your payment was started. Please contact the store before paying again."
msgstr "We konden niet bevestigen of je betaling is gestart. Neem contact op met de winkel voordat je opnieuw betaalt."

msgid "We could not confirm whether your payment was started. Please contact the store so we can check before you pay again."
msgstr "We konden niet bevestigen of je betaling is gestart. Neem contact op met de winkel zodat we dit kunnen controleren voordat je opnieuw betaalt."

msgid "We are still confirming your previous payment. Please wait before trying again."
msgstr "We zijn je vorige betaling nog aan het bevestigen. Wacht even voordat je het opnieuw probeert."

msgid "Your order has been received. Your payment is still being confirmed; please do not pay again. We will email you when it is confirmed."
msgstr "Je bestelling is ontvangen. Je betaling wordt nog bevestigd; betaal niet opnieuw. We sturen je een e-mail zodra de betaling is bevestigd."

msgid "Your payment has not been completed. You can return to checkout to continue."
msgstr "Je betaling is niet voltooid. Je kunt terugkeren naar de checkout om verder te gaan."

msgid "Your payment is already being processed. Please wait before trying again."
msgstr "Je betaling wordt al verwerkt. Wacht even voordat je het opnieuw probeert."

msgid "Your payment is being confirmed. Please do not pay again while we check it."
msgstr "Je betaling wordt bevestigd. Betaal niet opnieuw terwijl we dit controleren."

msgid "Your payment must be confirmed before you can try again. Please wait or contact the store."
msgstr "Je betaling moet eerst worden bevestigd voordat je het opnieuw kunt proberen. Wacht even of neem contact op met de winkel."

msgid "Your payment was cancelled or expired. You can try again or choose another payment method."
msgstr "Je betaling is geannuleerd of verlopen. Je kunt het opnieuw proberen of een andere betaalmethode kiezen."

msgid "Your previous payment needs to be checked. Please contact the store."
msgstr "Je vorige betaling moet worden gecontroleerd. Neem contact op met de winkel."

msgid "This payment attempt could not be verified. Please check your order or contact the store."
msgstr "Deze betaalpoging kon niet worden geverifieerd. Controleer je bestelling of neem contact op met de winkel."

msgid "This payment method is not available for your billing country or order amount. Please choose another method."
msgstr "Deze betaalmethode is niet beschikbaar voor je factuurland of bestelbedrag. Kies een andere methode."

msgid "This payment method is temporarily unavailable. Please choose another payment method."
msgstr "Deze betaalmethode is tijdelijk niet beschikbaar. Kies een andere betaalmethode."

msgid "This payment return link is invalid. Please check your order confirmation or contact the store."
msgstr "Deze betaalterugkeerlink is ongeldig. Controleer je orderbevestiging of neem contact op met de winkel."

msgid "This order could not be found."
msgstr "Deze bestelling kon niet worden gevonden."

msgid "This order has been refunded and cannot be paid again."
msgstr "Deze bestelling is terugbetaald en kan niet opnieuw worden betaald."

msgid "Try again"
msgstr "Opnieuw proberen"

msgid "A refund could not be confirmed. Check the ICEPAY Portal and reconcile it before issuing another refund."
msgstr "Een terugbetaling kon niet worden bevestigd. Controleer het ICEPAY Portal en stem deze af voordat je opnieuw terugbetaalt."

msgid "Create the refund through WooCommerce so its operation can be tracked safely."
msgstr "Maak de terugbetaling aan via WooCommerce zodat deze veilig kan worden bijgehouden."

msgid "Enter a positive refund amount with at most two decimal places."
msgstr "Voer een positief terugbetalingsbedrag in met maximaal twee decimalen."

msgid "ICEPAY rejected the refund. Please check the payment and try again."
msgstr "ICEPAY heeft de terugbetaling geweigerd. Controleer de betaling en probeer het opnieuw."

msgid "ICEPAY refund %s has an unknown outcome. Further API refunds are blocked until reconciled with ICEPAY."
msgstr "ICEPAY-terugbetaling %s heeft een onbekende uitkomst. Verdere API-terugbetalingen zijn geblokkeerd totdat dit met ICEPAY is afgestemd."

msgid "ICEPAY refund reconciliation checked the latest payment. Unmatched attempts remain blocked; review the ICEPAY Portal if necessary."
msgstr "De ICEPAY-terugbetalingsafstemming heeft de laatste betaling gecontroleerd. Niet-gematchte pogingen blijven geblokkeerd; controleer indien nodig het ICEPAY Portal."

msgid "ICEPAY refund reconciliation could not retrieve a verified payment. Check the ICEPAY Portal."
msgstr "De ICEPAY-terugbetalingsafstemming kon geen geverifieerde betaling ophalen. Controleer het ICEPAY Portal."

msgid "Only paid ICEPAY orders can be refunded through ICEPAY."
msgstr "Alleen betaalde ICEPAY-bestellingen kunnen via ICEPAY worden terugbetaald."

msgid "Reconcile ICEPAY refunds"
msgstr "ICEPAY-terugbetalingen afstemmen"

msgid "Recovered ICEPAY refund %s without sending another refund request."
msgstr "ICEPAY-terugbetaling %s hersteld zonder een nieuw terugbetalingsverzoek te sturen."

msgid "Review the existing refunds in ICEPAY before refunding again."
msgstr "Controleer de bestaande terugbetalingen in ICEPAY voordat je opnieuw terugbetaalt."

msgid "The original ICEPAY payment could not be verified."
msgstr "De oorspronkelijke ICEPAY-betaling kon niet worden geverifieerd."

msgid "The refund exceeds the remaining refundable amount."
msgstr "De terugbetaling overschrijdt het resterende terug te betalen bedrag."

msgid "This order is being updated. Please wait before refunding again."
msgstr "Deze bestelling wordt bijgewerkt. Wacht even voordat je opnieuw terugbetaalt."

msgid "Unable to verify the original payment before refunding."
msgstr "De oorspronkelijke betaling kon niet worden geverifieerd vóór de terugbetaling."

msgid "Additional ICEPAY payment completed (%1$s). Current gateway: %2$s; transaction: %3$s. Review this payment for a possible duplicate charge."
msgstr "Extra ICEPAY-betaling voltooid (%1$s). Huidige gateway: %2$s; transactie: %3$s. Controleer deze betaling op een mogelijke dubbele afschrijving."

msgid "ICEPAY payment %1$s completed after the order switched to gateway %2$s (previous transaction: %3$s). Completing the order through ICEPAY. Check both providers for a possible second payment before issuing a refund."
msgstr "ICEPAY-betaling %1$s is voltooid nadat de bestelling naar gateway %2$s was gewisseld (vorige transactie: %3$s). De bestelling wordt via ICEPAY afgerond. Controleer beide aanbieders op een mogelijke tweede betaling voordat je terugbetaalt."

msgid "ICEPAY payment creation has an unknown outcome. Check the ICEPAY Portal before retrying; clear _icepay_creation_uncertain only after reconciliation."
msgstr "Het aanmaken van de ICEPAY-betaling heeft een onbekende uitkomst. Controleer het ICEPAY Portal voordat je het opnieuw probeert; wis _icepay_creation_uncertain pas na afstemming."

msgid "Customer requested another payment attempt."
msgstr "Klant heeft een nieuwe betaalpoging aangevraagd."
